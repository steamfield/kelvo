{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the popover, dashboard and onboarding windows",
  "windows": ["popover", "dashboard", "onboarding"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/steamfield/statglass/issues/new?labels=sensors&title=*"
        },
        {
          "url": "https://github.com/steamfield/statglass/blob/main/.github/releasing.md#coordinated-protocol-upgrades"
        },
        {
          "url": "https://github.com/steamfield/statglass/releases/tag/v*"
        }
      ],
      "deny": [
        {
          "url": "https://github.com/steamfield/statglass/releases/tag/v*/*"
        }
      ]
    },
    "core:window:allow-start-dragging",
    "core:window:allow-close"
  ]
}
