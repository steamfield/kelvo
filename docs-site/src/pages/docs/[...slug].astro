---
import { getCollection, render } from "astro:content";
import { DocsShell } from "@/components/docs/DocsShell";
import BaseLayout from "@/layouts/BaseLayout.astro";
import {
  docPath,
  docsNav,
  featuredDocs,
  markdownExport,
  markdownPath,
  pageLinks,
} from "@/lib/docs";

export async function getStaticPaths() {
  const entries = await getCollection("docs");
  return entries.map((entry) => ({
    params: { slug: entry.id === "index" ? undefined : entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const entries = await getCollection("docs");
const { Content, headings } = await render(entry);
const site = String(Astro.site);
const { group, previous, next } = pageLinks(entries, entry.id);
const page = {
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  group: entry.id === "index" ? undefined : group,
  markdown: markdownExport(entry, entries, site),
  markdownHref: markdownPath(entry.id),
  markdownUrl: new URL(markdownPath(entry.id), site).href,
};
const title = entry.id === "index" ? "Docs" : `${entry.data.title} | Docs`;
---

<BaseLayout
  title={title}
  path={docPath(entry.id)}
  description={entry.data.description}
  alternate={markdownPath(entry.id)}
>
  <DocsShell
    nav={docsNav(entries)}
    page={page}
    headings={headings}
    featured={entry.id === "index" ? featuredDocs(entries) : []}
    previous={previous}
    next={next}
  >
    <Content />
  </DocsShell>
</BaseLayout>

<script>
  import { spyToc } from "@/lib/docs-enhance";
  spyToc(document);
</script>
